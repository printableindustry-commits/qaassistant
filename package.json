{
  "name": "wizard-qa",
  "version": "3.0.0",
  "private": true,
  "description": "Wizard QA : stack de test, récits JIRA, Gherkin, performance k6 et livrables QA. Appli web et extension VS Code issues du même code (server/).",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node server/portail.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:ext": "node scripts/build.mjs ext",
    "check": "node scripts/build.mjs check",
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "split-theme-css": "node scripts/split-theme-css.mjs",
    "format-stack-questionnaire": "node scripts/format-stack-questionnaire-conf.mjs",
    "test:perf:smoke": "k6 run k6/scripts/smoke.js -e BASE_URL=https://app-recette.example.com",
    "test:perf:smoke:json": "k6 run k6/scripts/smoke.js -e BASE_URL=https://app-recette.example.com --out json=reports/k6/smoke.json",
    "test:perf:reports:clean": "node -e \"require('fs').rmSync('reports/k6',{recursive:true,force:true}); require('fs').mkdirSync('reports/k6',{recursive:true})\""
  },
  "devDependencies": {
    "@types/k6": "^2.3.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
