      "options": [
        {
          "id": "modern",
          "label": "Application web moderne et homogène",
          "weights": {
            "cypress": 3,
            "playwright": 2
          }
        },
        {
          "id": "mixed",
          "label": "Mélange d'écrans anciens et récents",
