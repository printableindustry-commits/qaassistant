{
  "version": 1,
  "description": "Libellés et pondérations du questionnaire stack — modifiez les textes librement. Les ids (mainGoal, web, etc.) ne doivent pas changer.",
  "questions": [
    {
      "id": "mainGoal",
      "title": "Objectif principal",
      "question": "Quel est le principal objectif de vos tests automatisés ?",
      "hint": "Pensez à ce que vous devez vérifier au quotidien.",
      "options": [
        {
          "id": "web",
          "label": "Vérifier un site ou une application web (écrans, formulaires, parcours)",
          "weights": {
            "cypress": 3,
            "playwright": 3
          }
        },
        {
          "id": "api",
          "label": "Tester des services ou API (sans interface graphique)",
          "weights": {
            "postman": 5
          }
        },
        {
          "id": "process",
          "label": "Couvrir des processus métier complets (web, fichiers, intégrations…)",
          "weights": {
            "robot": 4,
            "playwright": 2
          }
        },
        {
          "id": "unsure",
          "label": "Je ne sais pas encore — j'ai besoin d'être guidé",
          "weights": {
            "cypress": 1,
            "robot": 1,
            "playwright": 1,
            "postman": 1
          }
        }
      ]
    },
    {
