      ],
      "requires": ["facts.lastCampaign", "profile.seuilReussite", "profile.valideur"]
    },
    {
      "id": "conception",
      "title": "Spécification de conception et des cas de test",
      "phase": "Conception",
      "ref": "ISO 29119-3 §8.2–8.3",
