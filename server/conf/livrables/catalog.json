        { "id": "inverse", "title": "Traçabilité inverse (scripts → exigences)", "required": true, "from": "facts" },
        { "id": "ecarts", "title": "Écarts de traçabilité", "required": true, "from": "facts" }
      ],
      "requires": ["facts.stories"]
    },
    {
      "id": "environnement",
      "title": "Disponibilité de l'environnement et des données de test",
      "phase": "Exécution",
      "ref": "ISO 29119-3 §8.5–8.6",
      "purpose": "Décrire les exigences d'environnement et de données de test, leur protection (RGPD) et confirmer leur disponibilité.",
      "audience": "Équipe de test, exploitation",
      "sections": [
        { "id": "exigences", "title": "Exigences d'environnement", "required": true, "from": "mixed" },
        { "id": "outillage", "title": "Outillage", "required": true, "from": "facts" },
        { "id": "donnees", "title": "Données de test", "required": true, "from": "profile" },
        { "id": "confidentialite", "title": "Confidentialité et protection des données", "required": true, "from": "profile" },
        { "id": "disponibilite", "title": "État de disponibilité", "required": true, "from": "facts" }
      ],
      "requires": ["profile.environnements", "profile.donneesTest", "profile.protectionDonnees"]
