      "id": "cloture",
      "title": "Rapport de clôture des tests",
      "phase": "Gestion",
      "ref": "ISO 29119-3 §7.4",
      "purpose": "Synthétiser les tests réalisés, évaluer les critères de sortie et formuler une recommandation de mise en production.",
      "audience": "Valideur, comité de mise en production",
      "sections": [
        { "id": "synthese", "title": "Synthèse et recommandation", "required": true, "from": "mixed" },
        { "id": "realise", "title": "Tests réalisés", "required": true, "from": "facts" },
        { "id": "criteres", "title": "Évaluation des critères de sortie", "required": true, "from": "mixed" },
        { "id": "anomalies", "title": "Anomalies résiduelles", "required": true, "from": "facts" },
        { "id": "ecarts", "title": "Écarts par rapport au plan", "required": true, "from": "facts" },
        { "id": "lecons", "title": "Enseignements", "required": false, "from": "facts" }
      ],
      "requires": ["facts.lastCampaign", "profile.seuilReussite", "profile.valideur"]
    },
    {
      "id": "conception",
      "title": "Spécification de conception et des cas de test",
      "phase": "Conception",
      "ref": "ISO 29119-3 §8.2–8.3",
      "purpose": "Décrire les conditions de test dérivées des récits et les cas de test (scénarios Gherkin) qui les couvrent.",
      "audience": "Équipe de test, analystes métier",
      "sections": [
        { "id": "bases", "title": "Bases de test", "required": true, "from": "facts" },
        { "id": "conditions", "title": "Conditions de test", "required": true, "from": "facts" },
        { "id": "cas", "title": "Cas de test", "required": true, "from": "facts" },
        { "id": "techniques", "title": "Techniques appliquées", "required": false, "from": "profile" },
        { "id": "ecarts", "title": "Récits non couverts", "required": true, "from": "facts" }
      ],
      "requires": ["facts.stories"]
    },
    {
      "id": "procedures",
      "title": "Spécification des procédures de test (scripts automatisés)",
      "phase": "Conception",
      "ref": "ISO 29119-3 §8.4",
      "purpose": "Décrire les scripts automatisés (Playwright, k6) qui exécutent les cas de test, leur ordre et leurs prérequis.",
      "audience": "Équipe d'automatisation, exploitation",
      "sections": [
        { "id": "outillage", "title": "Outillage", "required": true, "from": "facts" },
        { "id": "scripts", "title": "Scripts de test", "required": true, "from": "facts" },
        { "id": "execution", "title": "Lancement et ordonnancement", "required": true, "from": "mixed" },
        { "id": "prerequis", "title": "Prérequis", "required": false, "from": "mixed" },
        { "id": "performance", "title": "Tests de performance", "required": false, "from": "facts" }
      ],
      "requires": ["facts.automation.specs"]
    },
    {
      "id": "tracabilite",
      "title": "Matrice de traçabilité exigences ↔ tests",
      "phase": "Conception",
      "ref": "ISTQB CTFL §1.4.4",
      "purpose": "Relier chaque récit (exigence) à ses scénarios, scripts, tests Xray et dernier résultat d'exécution.",
      "audience": "Équipe projet, auditeurs, valideur",
      "sections": [
        { "id": "synthese", "title": "Synthèse de couverture", "required": true, "from": "facts" },
        { "id": "matrice", "title": "Matrice", "required": true, "from": "facts" },
        { "id": "ecarts", "title": "Écarts de traçabilité", "required": true, "from": "facts" }
      ],
      "requires": ["facts.stories"]
    },
    {
      "id": "environnement",
      "title": "Disponibilité de l'environnement et des données de test",
      "phase": "Exécution",
      "ref": "ISO 29119-3 §8.5–8.6",
      "purpose": "Décrire les environnements et jeux de données de test et confirmer leur disponibilité.",
      "audience": "Équipe de test, exploitation",
      "sections": [
        { "id": "environnements", "title": "Environnements de test", "required": true, "from": "mixed" },
        { "id": "donnees", "title": "Données de test", "required": true, "from": "mixed" },
        { "id": "outillage", "title": "Outillage disponible", "required": true, "from": "facts" },
        { "id": "disponibilite", "title": "État de disponibilité", "required": true, "from": "facts" }
      ],
      "requires": ["profile.environnements"]
    },
    {
      "id": "journal",
      "title": "Journal d'exécution des tests",
      "phase": "Exécution",
      "ref": "ISO 29119-3 §8.7",
      "purpose": "Consigner chronologiquement les campagnes d'exécution et leurs résultats détaillés.",
      "audience": "Équipe de test, auditeurs",
      "sections": [
        { "id": "campagnes", "title": "Campagnes d'exécution", "required": true, "from": "facts" },
        { "id": "detail", "title": "Détail de la dernière campagne", "required": true, "from": "facts" },
        { "id": "xray", "title": "Publication dans Xray", "required": false, "from": "facts" }
      ],
      "requires": ["facts.campaigns"]
    },
    {
      "id": "anomalies",
      "title": "Rapports d'anomalies",
      "phase": "Exécution",
      "ref": "ISO 29119-3 §8.8",
      "purpose": "Documenter les anomalies détectées par l'exécution des tests : description, impact, sévérité et état.",
      "audience": "Équipe de développement, équipe de test, chef de projet",
      "sections": [
        { "id": "synthese", "title": "Synthèse des anomalies", "required": true, "from": "facts" },
        { "id": "rapports", "title": "Rapports détaillés", "required": true, "from": "facts" },
        { "id": "processus", "title": "Processus de traitement", "required": false, "from": "profile" }
      ],
      "requires": ["facts.defects"]
    }
