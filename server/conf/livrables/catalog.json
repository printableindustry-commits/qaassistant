      "audience": "Équipe projet, équipe de test, valideurs",
      "sections": [
        { "id": "perimetre", "title": "Périmètre", "required": true, "from": "mixed" },
        { "id": "risques", "title": "Gestion des risques", "required": true, "from": "mixed" },
        { "id": "niveaux", "title": "Niveaux et types de test", "required": true, "from": "profile" },
        { "id": "techniques", "title": "Techniques de conception", "required": true, "from": "mixed" },
        { "id": "independance", "title": "Indépendance du test", "required": true, "from": "profile" },
