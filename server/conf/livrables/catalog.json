        { "id": "synthese", "title": "Synthèse", "required": true, "from": "facts" },
        { "id": "avancement", "title": "Avancement par rapport au plan", "required": true, "from": "mixed" },
        { "id": "metriques", "title": "Métriques d'exécution", "required": true, "from": "facts" },
        { "id": "obstacles", "title": "Obstacles", "required": true, "from": "mixed" },
        { "id": "risques", "title": "Risques", "required": true, "from": "mixed" },
