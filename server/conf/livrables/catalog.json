    {
      "id": "journal",
      "title": "Journal d'exécution des tests",
      "phase": "Exécution",
      "ref": "ISO 29119-3 §8.7",
      "purpose": "Consigner chronologiquement les campagnes d'exécution et leurs résultats détaillés.",
      "audience": "Équipe de test, auditeurs",
      "sections": [
        { "id": "objet", "title": "Objet", "required": true, "from": "profile" },
        { "id": "campagnes", "title": "Campagnes d'exécution", "required": true, "from": "facts" },
        { "id": "detail", "title": "Détail de la dernière campagne", "required": true, "from": "facts" },
        { "id": "xray", "title": "Publication dans Xray", "required": false, "from": "facts" }
      ],
      "requires": ["facts.campaigns"]
    },
    {
      "id": "anomalies",
      "title": "Rapports d'anomalies",
      "phase": "Exécution",
      "ref": "ISO 29119-3 §8.8",
      "purpose": "Documenter les anomalies détectées par l'exécution des tests : description, impact, sévérité et état.",
      "audience": "Équipe de développement, équipe de test, chef de projet",
      "sections": [
        { "id": "synthese", "title": "Synthèse des anomalies", "required": true, "from": "facts" },
        { "id": "rapports", "title": "Rapports détaillés", "required": true, "from": "mixed" },
        { "id": "processus", "title": "Processus de traitement", "required": true, "from": "profile" }
      ],
