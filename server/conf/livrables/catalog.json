      "requires": ["profile.produit", "profile.versionProduit", "profile.seuilReussite", "profile.jalons"]
    },
    {
      "id": "avancement",
      "title": "Rapport d'avancement des tests",
      "phase": "Gestion",
      "ref": "ISO 29119-3 §7.3",
      "purpose": "Rendre compte de l'avancement des tests par rapport au plan pour la période.",
      "audience": "Comité de pilotage, chef de projet",
