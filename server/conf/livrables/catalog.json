{
  "version": 1,
  "phases": ["Organisation", "Gestion", "Conception", "Exécution"],
  "documents": [
    {
      "id": "politique",
      "title": "Politique de test",
      "phase": "Organisation",
      "ref": "ISTQB CTAL-TM / ISO 29119-3 §6.2",
      "purpose": "Définir les objectifs, principes et pratiques de test de l'organisation pour le produit.",
      "audience": "Direction, responsables qualité et projet",
      "sections": [
        { "id": "objet", "title": "Objet et domaine d'application", "required": true, "from": "profile" },
        { "id": "objectifs", "title": "Objectifs du test", "required": true, "from": "mixed" },
        { "id": "processus", "title": "Processus de test", "required": true, "from": "mixed" },
        { "id": "organisation", "title": "Organisation et rôles", "required": true, "from": "profile" },
        { "id": "normes", "title": "Normes et exigences réglementaires", "required": true, "from": "profile" },
        { "id": "amelioration", "title": "Mesure et amélioration du processus", "required": false, "from": "facts" }
      ],
      "requires": ["profile.organisme", "profile.produit", "profile.contexteReglementaire", "profile.responsableTest"]
    },
    {
      "id": "strategie",
      "title": "Stratégie de test",
      "phase": "Organisation",
      "ref": "ISO 29119-3 §6.3",
      "purpose": "Décrire l'approche de test retenue : niveaux, types, techniques, automatisation, critères et risques.",
      "audience": "Équipe projet, équipe de test, valideurs",
      "sections": [
        { "id": "perimetre", "title": "Périmètre", "required": true, "from": "profile" },
        { "id": "risques", "title": "Analyse des risques produit", "required": true, "from": "mixed" },
        { "id": "niveaux", "title": "Niveaux et types de test", "required": true, "from": "profile" },
        { "id": "techniques", "title": "Techniques de conception", "required": true, "from": "profile" },
        { "id": "automatisation", "title": "Automatisation", "required": true, "from": "mixed" },
        { "id": "environnements", "title": "Environnements et outillage", "required": true, "from": "mixed" },
        { "id": "criteres", "title": "Critères d'entrée et de sortie", "required": true, "from": "profile" },
        { "id": "anomalies", "title": "Gestion des anomalies", "required": false, "from": "profile" },
        { "id": "livrables", "title": "Livrables de test", "required": false, "from": "facts" }
      ],
      "requires": ["profile.dansPerimetre", "profile.niveauxTest", "profile.typesTest", "profile.seuilReussite"]
    },
    {
      "id": "plan",
      "title": "Plan de test (maître)",
      "phase": "Gestion",
      "ref": "ISO 29119-3 §7.2",
      "purpose": "Planifier les activités de test du projet : périmètre, risques, approche, ressources, calendrier et critères.",
      "audience": "Chef de projet, équipe de test, valideur",
      "sections": [
        { "id": "contexte", "title": "Contexte du test", "required": true, "from": "profile" },
        { "id": "elements", "title": "Éléments de test", "required": true, "from": "facts" },
        { "id": "risques", "title": "Registre des risques", "required": true, "from": "mixed" },
        { "id": "approche", "title": "Approche de test", "required": true, "from": "mixed" },
        { "id": "criteres", "title": "Critères d'achèvement", "required": true, "from": "profile" },
        { "id": "suspension", "title": "Critères de suspension et de reprise", "required": false, "from": "profile" },
        { "id": "ressources", "title": "Rôles et responsabilités", "required": true, "from": "profile" },
        { "id": "planning", "title": "Calendrier", "required": true, "from": "profile" },
        { "id": "livrables", "title": "Livrables de test", "required": false, "from": "facts" }
      ],
      "requires": ["profile.produit", "profile.versionProduit", "profile.seuilReussite", "profile.jalons"]
    },
    {
      "id": "avancement",
      "title": "Rapport d'avancement des tests",
      "phase": "Gestion",
      "ref": "ISO 29119-3 §7.3",
      "purpose": "Rendre compte de l'avancement des tests par rapport au plan pour la période.",
      "audience": "Comité de pilotage, chef de projet",
      "sections": [
        { "id": "synthese", "title": "Synthèse", "required": true, "from": "facts" },
        { "id": "preparation", "title": "Avancement de la préparation", "required": true, "from": "facts" },
        { "id": "resultats", "title": "Résultats d'exécution", "required": true, "from": "facts" },
        { "id": "anomalies", "title": "Anomalies", "required": true, "from": "facts" },
        { "id": "risques", "title": "Risques et points d'attention", "required": true, "from": "mixed" },
        { "id": "prochaines", "title": "Activités prévues", "required": false, "from": "facts" }
      ],
      "requires": ["facts.lastCampaign"]
    },
