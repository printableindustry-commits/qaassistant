      "sections": [
        { "id": "bases", "title": "Bases de test", "required": true, "from": "facts" },
        { "id": "fonctionnalites", "title": "Ensembles de fonctionnalités", "required": true, "from": "facts" },
        { "id": "conditions", "title": "Conditions de test", "required": true, "from": "facts" },
