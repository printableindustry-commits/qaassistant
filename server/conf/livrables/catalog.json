      "audience": "Équipe d'automatisation, exploitation",
      "sections": [
        { "id": "outillage", "title": "Outillage", "required": true, "from": "facts" },
        { "id": "scripts", "title": "Scripts de test", "required": true, "from": "facts" },
        { "id": "ordre", "title": "Ordre d'exécution", "required": true, "from": "mixed" },
        { "id": "preconditions", "title": "Préconditions", "required": true, "from": "facts" },
        { "id": "comptes", "title": "Jeu de comptes de test", "required": true, "from": "profile" },
        { "id": "performance", "title": "Tests de performance", "required": false, "from": "facts" }
      ],
      "requires": ["facts.automation.specs"]
