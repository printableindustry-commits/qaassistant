{
  "version": 1,
  "phases": ["Organisation", "Gestion", "Conception", "Exécution"],
  "documents": [
    {
      "id": "politique",
      "title": "Politique de test",
      "phase": "Organisation",
      "ref": "ISTQB CTAL-TM / ISO 29119-3 §6.2",
      "purpose": "Définir les objectifs, principes et pratiques de test de l'organisation pour le produit.",
      "audience": "Direction, responsables qualité et projet",
      "sections": [
        { "id": "objet", "title": "Objet et domaine d'application", "required": true, "from": "profile" },
        { "id": "objectifs", "title": "Objectifs du test", "required": true, "from": "profile" },
        { "id": "processus", "title": "Processus de test", "required": true, "from": "mixed" },
        { "id": "organisation", "title": "Organisation et rôles", "required": true, "from": "profile" },
        { "id": "formation", "title": "Formation des testeurs", "required": true, "from": "profile" },
        { "id": "ethique", "title": "Éthique", "required": true, "from": "profile" },
        { "id": "normes", "title": "Normes et exigences réglementaires", "required": true, "from": "profile" },
        { "id": "mesure", "title": "Mesure de la valeur du test", "required": true, "from": "facts" },
        { "id": "archivage", "title": "Archivage et réutilisation des actifs de test", "required": false, "from": "profile" },
        { "id": "amelioration", "title": "Amélioration du processus", "required": true, "from": "profile" },
        { "id": "approbation", "title": "Circuit d'approbation", "required": false, "from": "profile" }
      ],
      "requires": ["profile.organisme", "profile.produit", "profile.contexteReglementaire", "profile.responsableTest"]
    },
    {
