      ],
      "cible": ".p-modal:has(.xp-root), .xp-root", "secondes": 4,
      "titre": "Envoi vers Xray (simulé)",
      "texte": "Un ticket Test relié au récit et au plan de test : aperçu, puis envoi simulé en démonstration."
    },
    {
      "id": "campagne", "page": "/livrables.html",
      "action": [
        { "clic": "Simuler", "dans": ".lv-camp-actions button", "max": 15000, "note": "Lancer une campagne (simulée)", "attente": 3000 },
        { "clic": "Résultats par test", "dans": "button", "note": "Ouvrir les résultats par test", "attente": 2500 },
        { "fermer": true },
        { "clic": "Anomalies", "dans": ".lv-camp-actions button, button", "note": "Ouvrir les anomalies", "attente": 2500 },
