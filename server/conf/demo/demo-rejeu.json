    {
      "id": "rejeu", "page": "/automatisation.html?key=P0326-9310",
      "action": [
        { "clic": "Rejouer", "dans": "button", "note": "Rejouer le test (navigateur sans fenêtre)", "attente": 1500 },
        { "clic": ".p-overlay .p-modal .p-btn--primary", "optionnel": true, "note": "Arrêter l’autre session active", "attente": 1500 },
        { "attente": 7000 }
      ],
      "cible": ".au-main .p-banner, .au-steps", "secondes": 4,
      "titre": "Rejeu",
      "texte": "Le test est rejoué tel quel avant d’être validé : pas de test fragile en base."
    },
    {
      "id": "xray", "page": "/automatisation.html?key=P0326-9301",
      "action": [
        { "clic": "Envoyer dans JIRA", "dans": ".p-step", "note": "Étape « Envoyer dans JIRA »" },
        { "clic": "Envoyer dans JIRA / Xray", "dans": "button", "note": "Ouvrir l’envoi vers Xray", "attente": 1500 },
        { "saisie": { "cible": "#xpPlan", "texte": "P0326-10528" }, "note": "Saisir le plan de test P0326-10528", "attente": 1200 },
        { "clic": ".xp-suggest-item", "optionnel": true, "note": "Choisir le plan de test (fictif)" },
