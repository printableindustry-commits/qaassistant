    {
      "id": "test-genere", "page": "/automatisation.html?key=P0326-9310",
      "action": [
        { "clic": "Test généré", "dans": ".p-step", "note": "Ouvrir le test généré", "attente": 1200 }
      ],
      "cible": ".au-steps, .p-code", "secondes": 4,
      "titre": "Test Playwright généré",
      "texte": "Étapes lisibles (Règle, Heuristique, IA, Testeur) et code Playwright, sans mot de passe."
