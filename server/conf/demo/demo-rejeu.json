      "titre": "Pilotage",
      "texte": "Le point d’entrée : indicateurs et parcours QA, en un coup d’œil (données fictives IRMA)."
    },
    {
      "id": "scan", "page": "/connaissance.html#scan",
      "action": [
        { "clic": "Mon JIRA", "dans": ".kn-choice-item", "note": "Choisir « Mon JIRA »" },
        { "saisie": { "cible": "input[type=url], input.p-mono", "texte": "https://jira.banque-horizon.example/jira/software/projects/P0326/boards/12" }, "note": "Coller l’URL du tableau JIRA (fictive)", "attente": 1200 },
        { "clic": "Données de démonstration", "dans": ".kn-choice-item", "note": "Choisir le jeu de démonstration IRMA" },
        { "clic": "Lancer le scan", "dans": "button", "note": "Lancer le scan des récits (données fictives)", "attente": 2500 }
      ],
      "cible": ".p-kpis", "secondes": 4,
      "titre": "Synthèse du scan",
      "texte": "Une URL JIRA suffit : récits, critères d’acceptation extraits, points à clarifier et épopées."
    },
    {
      "id": "clarifier", "page": "/connaissance.html#synthese", "cible": ".kn-issue", "secondes": 5,
      "titre": "À clarifier avec le PO",
      "texte": "Récits sans critère, cas d’erreur absents : les questions sont prêtes."
    },
    {
      "id": "tri", "page": "/recits.html",
      "action": [
        { "clic": "Tous", "dans": ".p-tab", "note": "Ouvrir la file « Tous »" },
