        { "clic": ".rc-decide-btn.rc-decide--todo", "note": "Passer le récit « À automatiser »" },
        { "saisie": { "cible": "Raison", "texte": "Parcours métier critique pour le comité des risques", "entree": true }, "note": "Saisir la raison de la décision" },
